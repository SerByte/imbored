# ── База данных ───────────────────────────────────────────────────────────────
# Прод: Turso (turso.tech → Create Database). Локально можно не задавать —
# тогда используется файл data/imbored.db.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ── Сессии ────────────────────────────────────────────────────────────────────
# ОБЯЗАТЕЛЬНО в проде: длинная случайная строка (32+ символа).
# Ей подписывается кука; со значением по умолчанию куку можно подделать.
SESSION_SECRET=

# ── Steam ─────────────────────────────────────────────────────────────────────
# Ключ: https://steamcommunity.com/dev/apikey (бесплатно, нужен аккаунт
# с покупками от $5 и Steam Guard). Без ключа работает демо-режим.
STEAM_API_KEY=

# Регион цен в Steam Store: us, ru, eu…
STEAM_STORE_CC=us

# ── Claude ────────────────────────────────────────────────────────────────────
# https://platform.claude.com — умные объяснения подбора и pros/cons.
# Без ключа работает эвристический фолбэк.
ANTHROPIC_API_KEY=

# ── Патчноуты ─────────────────────────────────────────────────────────────────
# Секрет для /api/cron/news (лента «Что нового»). Vercel сам шлёт его в
# заголовке Authorization, когда переменная задана в проекте.
# ОБЯЗАТЕЛЬНО в проде: без него роут закрыт наглухо (401), и обновления
# перестанут подтягиваться. Локально можно не задавать.
CRON_SECRET=

# Модель для пересказов и подбора. По умолчанию claude-haiku-4-5.
LLM_MODEL=

# ── Прочее ────────────────────────────────────────────────────────────────────
# Базовый URL для возврата из Steam OpenID. В проде: https://imbored.cc
APP_BASE_URL=http://localhost:3000

# Ссылка на донат (Boosty / Ko-fi). Пусто — блок на /support скрыт.
NEXT_PUBLIC_DONATE_URL=
