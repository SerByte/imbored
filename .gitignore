# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# локальная база (в ней библиотеки реальных пользователей)
/data

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# создаётся `vercel link`; .env.example остаётся в репозитории как образец
.env.local

# Пустышки, которые libsql создаёт в рабочем каталоге при некоторых
# конфигурациях подключения. Содержимого не имеют, в репозиторий попали случайно.
#
# Косая черта в начале обязательна: без неё «auth» совпадает с ЛЮБЫМ путём, где
# встречается такой сегмент, и app/api/auth/... молча выпадал из репозитория.
# Уже отслеживаемые файлы это не задевало, поэтому обнаружилось только сейчас —
# на новом роуте внутри app/api/auth, который git отказывался замечать.
/auth
/auth-wal
/db
/db-wal

# Черновики и одноразовые симуляции: считают что-нибудь на реальном каталоге
# и живут ровно один прогон.
scripts/_*
